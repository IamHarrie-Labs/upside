import {createRequire} from 'node:module';
import {writeFileSync} from 'node:fs';
const require=createRequire(import.meta.url);
const {chromium}=require('C:/Users/Harrie/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/node_modules/playwright');
const b=await chromium.launch({headless:true,executablePath:'C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe'});
const p=await b.newPage({viewport:{width:390,height:844}});
await p.goto('http://127.0.0.1:5173');
await p.getByRole('heading',{name:'Good calls. Shared upside.'}).waitFor();
await p.keyboard.press('Tab');
if(await p.evaluate(()=>document.activeElement?.textContent)!=='Skip to content')throw new Error('Skip link not first keyboard stop');
await p.keyboard.press('Enter');
if(await p.evaluate(()=>document.activeElement?.id)!=='landing-main')throw new Error('Skip link did not move focus');
await p.emulateMedia({reducedMotion:'no-preference'});
await p.goto('http://127.0.0.1:5173');
await p.getByRole('button',{name:'Pause motion'}).waitFor();
await p.waitForFunction(()=>{const video=document.querySelector('video');return video&&!video.paused&&video.readyState>=2});
await p.getByRole('button',{name:'Pause motion'}).click();
await p.waitForFunction(()=>document.querySelector('video')?.paused);
if(await p.locator('.clouds').evaluate((e:any)=>getComputedStyle(e).animationPlayState)!=='paused')throw new Error('Cloud pause failed');
await p.getByRole('button',{name:'Resume motion'}).click();
await p.waitForFunction(()=>document.querySelector('video')?.paused===false);
await p.emulateMedia({reducedMotion:'reduce'});
await p.waitForFunction(()=>document.querySelector('video')?.paused);
if(await p.locator('.clouds').evaluate((e:any)=>getComputedStyle(e).animationName)!=='none')throw new Error('Reduced motion ignored');
const unnamed=await p.locator('button').evaluateAll((els:any[])=>els.filter(e=>!e.getAttribute('aria-label')&&!e.textContent.trim()).length);
if(unnamed)throw new Error('Unnamed buttons');
writeFileSync('docs/design/accessibility-results.json',JSON.stringify({date:'2026-10-08',keyboardSkip:true,pauseMotion:true,reducedMotion:true,namedButtons:true,videoPause:true,scope:'Targeted browser checks, not a full accessibility certification'},null,2));
await b.close();console.log('Keyboard skip, video/cloud pause and reduced-motion checks passed.');
